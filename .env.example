# Copy this file to .env and fill in real values. .env is git-ignored; never commit it.

# --- Firebase (browser-safe config: protect data with Firestore rules and authorized domains) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- SerpApi (SERVER-ONLY secret, used by api/flights.js) ---
# Do NOT prefix with VITE_: any VITE_ variable is bundled into the public JavaScript.
# On Vercel, add it under Project Settings > Environment Variables.
SERPAPI_KEY=
